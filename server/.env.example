# このファイルを .env にコピーして、パスワードとAPI_KEYを設定してください(.env はGitHubに載せません)
PGHOST=172.18.61.232
PGPORT=5432
PGDATABASE=test_db
PGUSER=test_user01
PGPASSWORD=ここにDBのパスワード
# アプリの設定画面に入力する合言葉(長めのランダム文字列)
API_KEY=ここに合言葉
PORT=8443
# スマホのカメラはHTTPSが必須です。証明書がある場合は指定します(無ければHTTPで起動)
# TLS_CERT=/path/to/server.crt
# TLS_KEY=/path/to/server.key
# GitHub Pagesから使う場合は、そのアドレス(オリジン)を指定
ALLOW_ORIGIN=https://moppe1979.github.io
# 1にすると、このサーバーでアプリ画面も配信します(同じアドレスで使えます)
SERVE_APP=1
